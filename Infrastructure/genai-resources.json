    "baseName": {
      "type": "string",
      "defaultValue": "expensemgmt",
      "metadata": {
        "description": "Base name for resources"
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "metadata": {
        "description": "Environment suffix"
      }
    },
    "includeChatUI": {
      "type": "bool",
