  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "uksouth",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "baseName": {
      "type": "string",
      "defaultValue": "expensemgmt",
      "metadata": {
        "description": "Base name for resources"
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "metadata": {
        "description": "Environment suffix"
      }
    },
    "timestamp": {
      "type": "string",
      "defaultValue": "[utcNow('ddHHmm')]",
      "metadata": {
        "description": "Timestamp for unique naming"
      }
    },
    "managedIdentityClientId": {
      "type": "string",
      "metadata": {
        "description": "User Assigned Managed Identity Client ID"
      }
    },
    "managedIdentityId": {
      "type": "string",
      "metadata": {
        "description": "User Assigned Managed Identity Resource ID"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "[format('asp-{0}-{1}', parameters('baseName'), parameters('environment'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "B1",
        "tier": "Basic",
        "capacity": 1
      },
      "kind": "linux",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[format('app-{0}-{1}-{2}', parameters('baseName'), parameters('environment'), parameters('timestamp'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('managedIdentityId'))]": {}
        }
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('asp-{0}-{1}', parameters('baseName'), parameters('environment')))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "DOTNETCORE|8.0",
          "alwaysOn": false,
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "http20Enabled": true,
          "appSettings": [
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "1"
            },
            {
              "name": "ManagedIdentityClientId",
              "value": "[parameters('managedIdentityClientId')]"
            },
            {
              "name": "EnableChatUI",
              "value": "true"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', format('asp-{0}-{1}', parameters('baseName'), parameters('environment')))]"
      ]
    }
  ],
  "outputs": {
    "appServiceName": {
      "type": "string",
      "value": "[format('app-{0}-{1}-{2}', parameters('baseName'), parameters('environment'), parameters('timestamp'))]"
    },
    "appServiceUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', format('app-{0}-{1}-{2}', parameters('baseName'), parameters('environment'), parameters('timestamp'))), '2023-01-01').defaultHostName)]"
    },
    "appServiceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/sites', format('app-{0}-{1}-{2}', parameters('baseName'), parameters('environment'), parameters('timestamp')))]"
    }
  }
